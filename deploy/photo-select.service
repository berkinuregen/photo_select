[Unit]
Description=Photo Select FastAPI
After=network.target

[Service]
Type=simple
User=photo-select
Group=photo-select
WorkingDirectory=/opt/photo-select
EnvironmentFile=/opt/photo-select/.env
ExecStart=/opt/photo-select/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/photo-select/data /opt/photo-select/uploads

[Install]
WantedBy=multi-user.target
